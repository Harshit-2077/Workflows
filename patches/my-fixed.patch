+static void hdd_queue_monitor_station_restore(struct hdd_context *hdd_ctx)
+{
+	if (!hdd_ctx->monitor_restore_pending || !hdd_ctx->adapter_ops_wq ||
+	    hdd_ctx->monitor_restore_work_status != HDD_WORK_INITIALIZED)
